{
  "name": "commerce-orderdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Nauman Masood",
  "description": "Full-stack regional ordering with React, TypeScript, Node.js and PostgreSQL.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server/main.ts",
    "web": "vite --host 127.0.0.1 --port 5177",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "format": "prettier --write web server shared tests scripts *.ts *.json *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check web server shared tests scripts *.ts *.json *.yaml .github/workflows/*.yml"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
